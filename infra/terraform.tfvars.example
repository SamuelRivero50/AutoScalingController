# Copy to terraform.tfvars (ignored by git) and fill in.
region            = "us-east-1"
operator_ssh_cidr = "203.0.113.10/32" # your public IP, /32
key_name          = "vockey"          # Learner Lab key pair; "" disables SSH keys

# Learner Lab: keep create_iam = false and use the lab's instance profile.
create_iam            = false
instance_profile_name = "LabInstanceProfile"

detailed_monitoring = true
profile             = "realistic"
